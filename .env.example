# Mad Factory keys. Infrastructure credentials only; anything about a product or campaign lives in the database.
# Only the Supabase block is required. Each other block turns on one feature; leave it blank to keep that feature
# off. `pnpm doctor` shows what is set (names only) and what each missing block would turn on.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Supabase (server-side; the service role key bypasses RLS, never expose it to a browser).
# supabase.com → your project → Project settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Postgres connection string, used only by `pnpm db:migrate` (or apply migrations with `supabase db push`).
# Supabase → Connect → Session pooler URI (IPv4; the direct host is IPv6-only).
SUPABASE_DB_URL=

# ScrapeCreators: competitor ads from the Meta Ad Library (`pnpm scrape`) and Instagram/TikTok/Facebook posts
# (`pnpm social`). Paid per request: scrapecreators.com. Without it, `pnpm scrape --collector playwright` uses a local
# browser (run `pnpm exec playwright install chromium` once).
SCRAPECREATORS_API_KEY=
# X API bearer token (optional): X posts and replies for B2B Social (pnpm b2b-social sync)
X_BEARER_TOKEN=
# Exa Agent with Fiber people data for B2B Social (about $0.04–0.08 per person)
EXA_API_KEY=

# Cloudflare R2 (S3-compatible) for downloaded videos and images. Configure all five values to enable R2; otherwise
# media stays in ./data/media locally and the web app shows placeholders instead of previews.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (r2.dev or a custom domain), e.g. https://media.example.com
R2_PUBLIC_URL=

# Optional rotating proxy for the Playwright collector, e.g. http://user:pass@host:port
PROXY_URL=

# Your own Meta ad account (`pnpm meta-ads`). A system-user token with ads_read; ads_management only if you will run
# the approved write commands. Meta Business settings → System users.
META_ADS_TOKEN=

# Your own Apple Ads campaigns (`pnpm apple-ads`). ads.apple.com → Account settings → API. Either a credentials
# directory (local machine): credentials.json { clientId, teamId, keyId, privateKeyPath } + token-cache.json, kept
# outside git, mode 700
APPLE_ADS_DIR=
# ...or the four values directly (CI; use a read-only API user there). APPLE_ADS_PRIVATE_KEY is the PEM text.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_PRIVATE_KEY=

# RevenueCat API v2 secret key, read-only Charts & metrics (`pnpm revenuecat`): trials, conversions and revenue, so
# the overview can show profit. The project id is not here; it is a tracked source (source revenuecat, kind project).
REVENUECAT_API_KEY=

# Google Gemini, for AI breakdowns of ad videos and images (`pnpm creatives profile`). aistudio.google.com
# The default model is the latest stable Gemini Flash, resolved at runtime.
GEMINI_API_KEY=
# Optional: Vercel AI Gateway, only when passing a google/… model id to --model.
AI_GATEWAY_API_KEY=

# ── Web app ──────────────────────────────────────────────────────────────────────────────────────────────────────
# On a web host (Vercel or any) set only the Supabase and AUTH_* values. Never put META_ADS_TOKEN or the APPLE_ADS_*
# keys there, so a stolen sign-in or MCP key has nothing that could change a campaign.
# GitHub sign-in: create an OAuth app at https://github.com/settings/developers with the callback
# <app url>/api/auth/callback. Only the GitHub user IDs below can sign in.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# 32+ random characters that sign the session cookie: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated numeric GitHub user IDs (not usernames, which can be renamed and re-registered).
# Find yours at https://api.github.com/users/<username> (the "id" field).
AUTH_ALLOWED_GITHUB_IDS=
# Optional public origin when a proxy rewrites the host, e.g. https://dash.example.com
# AUTH_URL=
# Local `next dev` only (ignored in production builds): skip sign-in.
# AUTH_DISABLED=true
